{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "region",
    "version",
    "provenance",
    "packages"
  ],
  "properties": {
    "schema": {
      "const": "moly-asset-packs/2"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,15}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "manifest",
        "content_id",
        "dependencies",
        "paths",
        "download_bytes",
        "content_bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "type": "string",
          "pattern": "^packages/[0-9a-f]{64}\\.json$"
        },
        "content_id": {
          "$ref": "#/$defs/sha256"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "download_bytes": {
          "$ref": "#/$defs/size"
        },
        "content_bytes": {
          "$ref": "#/$defs/size"
        }
      }
    }
  }
}
