{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "version", "generated_utc", "blob_prefix", "download_bytes", "resident_bytes", "content_bytes", "logical_bytes", "transforms", "entries"],
  "properties": {
    "schema": {"const": "moly-asset-manifest/1"},
    "version": {"type": "string", "minLength": 1},
    "generated_utc": {"type": "string", "minLength": 1},
    "blob_prefix": {"type": "string", "minLength": 1},
    "download_bytes": {"$ref": "#/$defs/size"},
    "resident_bytes": {"$ref": "#/$defs/size"},
    "content_bytes": {"$ref": "#/$defs/size"},
    "logical_bytes": {"$ref": "#/$defs/size"},
    "transforms": {"type": "object"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "size": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "required": ["path", "blob", "blob_bytes", "blob_sha256", "bytes", "content_sha256", "codec", "http_encoding", "xf"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "blob": {"type": "string", "minLength": 1},
        "blob_bytes": {"$ref": "#/$defs/size"},
        "blob_sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"$ref": "#/$defs/size"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "codec": {"enum": ["identity", "gzip", "brotli"]},
        "http_encoding": {"enum": ["identity", "br"]},
        "xf": {"enum": [null, "meshopt", "draco", "ktx2"]}
      }
    }
  }
}
